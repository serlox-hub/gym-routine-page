# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Video storage (MinIO): el cliente web NO lo configura aqui. Las credenciales viven como
# secrets de las Edge Functions video-upload/video-url (MINIO_ENDPOINT/MINIO_ACCESS_KEY/
# MINIO_SECRET_KEY, sin prefijo VITE_) — se gestionan en el dashboard de Supabase o con
# `supabase secrets set`, nunca en este .env. Ver docs/DECISIONS.md.

# GIFs de ejercicio (opcional, SOLO DESARROLLO: en produccion se ignora).
# Base del bucket publico exercise-gifs.
# Solo hace falta apuntando la app a la Supabase LOCAL: alli el bucket esta vacio y
# cada tarjeta de sesion dispara un 404. Vacio = se usa el Storage del propio cliente.
VITE_EXERCISE_GIFS_BASE_URL=

# Sentry (opcional, solo produccion)
VITE_SENTRY_DSN=

# E2E tests
# Contra la Supabase LOCAL (`supabase start` desde apps/web) el usuario ya existe: lo crea
# `supabase/seed.sql` en cada `db reset`, con estas credenciales fijas (solo valen en local, la
# BD escucha en 127.0.0.1 y usa el JWT secret publico de la CLI):
#   E2E_TEST_EMAIL=e2e@local.test
#   E2E_TEST_PASSWORD=e2e-local-password
# Contra el proyecto remoto son las del usuario de test real, que NO se versionan.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

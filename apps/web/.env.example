# Supabase local: identidad y puertos del stack (issue #63)
# La CLI de Supabase lee estas variables de este archivo (.env) y de .env.local, que gana.
# ⚠️ OBLIGATORIAS: config.toml las interpola y un puerto sin definir NO cae a un default, revienta
# con ProjectConfigParseError. Anade este bloque a tu .env (o a tu .env.local)
# antes del primer `npx supabase start`.
# Con un worktree por rama (lanes), dale a cada uno su propio bloque en SU .env.local para que no
# compartan BD: el convenio es sumar N*10 a cada puerto y sufijar el id (lane 1 -> 5433x, lane 2 ->
# 5434x). Sin eso, un `db reset` de una lane (los e2e y db:schema empiezan por ahi) borra la BD de
# las otras.
GYM_SUPABASE_PROJECT_ID=gym-routine-page
GYM_SUPABASE_API_PORT=54321
GYM_SUPABASE_DB_PORT=54322
GYM_SUPABASE_STUDIO_PORT=54323
GYM_SUPABASE_INBUCKET_PORT=54324

# Supabase
# Probar desde el movil (`vite --host`): el login con Google vuelve a la Site URL, que es PROD, salvo
# que anadas la URL de la LAN (exacta, sin barra final) a Authentication > Redirect URLs. Mira la
# barra de direcciones tras el login. Para usar la remota sin tocar archivos, desde apps/web:
# env $(grep -E '^VITE_SUPABASE_(URL|ANON_KEY)=' .env | xargs) npx vite --host
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Video storage (MinIO): el cliente web NO lo configura aqui. Las credenciales viven como
# secrets de las Edge Functions video-upload/video-url (MINIO_ENDPOINT/MINIO_ACCESS_KEY/
# MINIO_SECRET_KEY, sin prefijo VITE_) — se gestionan en el dashboard de Supabase o con
# `supabase secrets set`, nunca en este .env. Ver docs/DECISIONS.md.

# GIFs de ejercicio (opcional, SOLO DESARROLLO: en produccion se ignora).
# Base del bucket publico exercise-gifs.
# Solo hace falta apuntando la app a la Supabase LOCAL: alli el bucket esta vacio y
# cada tarjeta de sesion dispara un 404. Vacio = se usa el Storage del propio cliente.
VITE_EXERCISE_GIFS_BASE_URL=

# Sentry (opcional, solo produccion)
VITE_SENTRY_DSN=

# Auto-login en dev (opcional, apagado por defecto).
# Con VITE_DEV_AUTOLOGIN=true, si no hay sesion y VITE_SUPABASE_URL apunta a local/LAN
# (127.0.0.1, localhost o un rango privado: 192.168/16, 10/8, 172.16-31), la app inicia sesion
# sola con el usuario de seed (e2e@local.test). Utll para probar desde el movil con
# `npm run dev -- --host` sin tener que loguearte a mano cada vez que un `db reset` invalida la
# sesion. Debe quedar en 'false' (o sin declarar) en el .env.local que usan los e2e de Playwright:
# ese servidor tambien es `vite` en dev contra la Supabase local, y auth.spec.js/navigation.spec.js
# verifican justo el estado SIN sesion. Ver components/Auth/DevAutoLogin.jsx.
VITE_DEV_AUTOLOGIN=

# E2E tests (Playwright)
# Corren SOLO contra la Supabase LOCAL, y playwright.config.js aborta si VITE_SUPABASE_URL no
# apunta a 127.0.0.1/localhost. Motivo: `npm run test:e2e` empieza por `supabase db reset`, o sea
# que RECONSTRUYE LA BD ENTERA y se lleva por delante lo que tuvieras en la local. Los tests
# escriben datos de verdad y no limpian nada; el reset es lo que evita que se acumulen (sin el la
# suite empieza a fallar sola a partir de la tercera ejecucion seguida).
#
# Para ejecutarlos: `npx supabase start` desde apps/web y un `.env.local` (no versionado) con lo
# de abajo. Nada de esto es secreto: la BD escucha en 127.0.0.1, usa el JWT secret publico de la
# CLI, y el usuario lo crea supabase/seed.sql en cada reset. Los valores son fijos, iguales en
# cualquier maquina salvo el PUERTO de la URL, que es el de tu GYM_SUPABASE_API_PORT (arriba).
# Si no coinciden, `pretest:e2e` aborta: resetearias tu stack y escribirias en el de otro worktree.
#
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#   E2E_TEST_EMAIL=e2e@local.test
#   E2E_TEST_PASSWORD=e2e-local-password
#
# `.env.local` gana sobre `.env` (precedencia de Vite, replicada en scripts/loadEnv.js para que
# la cadena de los e2e vea lo mismo que el dev server). Consecuencia: mientras exista, TODO lo que
# pasa por Vite apunta a la local — `dev`, `build`, `preview` y los tests unitarios. Los deploys
# no: Vercel construye desde git y alli este archivo no existe. En la local el bucket de GIFs esta
# vacio (ver VITE_EXERCISE_GIFS_BASE_URL arriba) y tu cuenta empieza de cero. Para volver al
# proyecto remoto, renombra o borra `.env.local`; `.env` sigue debajo intacto.
#
# Las dos de abajo se dejan puestas aqui porque solo valen contra la local: sin `.env.local` no
# hacen nada (el guard aborta antes).
E2E_TEST_EMAIL=e2e@local.test
E2E_TEST_PASSWORD=e2e-local-password

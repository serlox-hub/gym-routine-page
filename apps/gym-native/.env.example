# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# GIFs de ejercicio (opcional, SOLO DESARROLLO: en produccion se ignora).
# Base del bucket publico exercise-gifs.
# Solo hace falta apuntando la app a la Supabase LOCAL: alli el bucket esta vacio y
# cada tarjeta de sesion dispara un 404. Vacio = se usa el Storage del propio cliente.
EXPO_PUBLIC_EXERCISE_GIFS_BASE_URL=

# Sentry (opcional, solo produccion)
EXPO_PUBLIC_SENTRY_DSN=
